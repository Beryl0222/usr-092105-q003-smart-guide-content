{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "智能讲解内容发布领域事件",
  "description": "用于跨模块交换事实记录的公共信封。事实、解释性主张、翻译修订、内容包、紧急通知、设备回执各走独立聚合流，事件只能引用下列白名单组合。",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 8,
      "description": "事件唯一标识，来源系统重试时必须沿用原标识"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "CLAIM_RECORDED",
        "EXPERT_OPINION_ADDED",
        "CLAIM_APPROVED",
        "CLAIM_REVISED",
        "QA_TEMPLATE_APPROVED",
        "GLOSSARY_TERM_APPROVED",
        "TRANSLATION_PROPOSED",
        "TRANSLATION_REVIEWED",
        "PACKAGE_DRAFTED",
        "PACKAGE_PUBLISHED",
        "PACKAGE_WITHDRAWN",
        "NOTICE_ISSUED",
        "NOTICE_COUNTERSIGNED",
        "NOTICE_EXPIRED",
        "DEVICE_REGISTERED",
        "DEVICE_ACKNOWLEDGED",
        "DEVICE_HEARTBEAT"
      ],
      "description": "本领域事件类型"
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "knowledge_claim",
        "translation_revision",
        "content_package",
        "device_receipt"
      ],
      "description": "业务对象类型"
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1,
      "description": "业务对象标识"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "事实发生时间（真实世界时间，非入库时间）"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "聚合流内版本，从 1 开始严格递增"
    },
    "summary": {
      "type": "string",
      "minLength": 2,
      "description": "中文事实摘要"
    }
  },
  "comment:event_type_by_aggregate": {
    "knowledge_claim": [
      "CLAIM_RECORDED",
      "EXPERT_OPINION_ADDED",
      "CLAIM_APPROVED",
      "CLAIM_REVISED",
      "QA_TEMPLATE_APPROVED",
      "GLOSSARY_TERM_APPROVED"
    ],
    "translation_revision": [
      "TRANSLATION_PROPOSED",
      "TRANSLATION_REVIEWED"
    ],
    "content_package": [
      "PACKAGE_DRAFTED",
      "PACKAGE_PUBLISHED",
      "PACKAGE_WITHDRAWN",
      "NOTICE_ISSUED",
      "NOTICE_COUNTERSIGNED",
      "NOTICE_EXPIRED"
    ],
    "device_receipt": [
      "DEVICE_REGISTERED",
      "DEVICE_ACKNOWLEDGED",
      "DEVICE_HEARTBEAT"
    ]
  },
  "additionalProperties": true
}
