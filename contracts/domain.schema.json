{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "智能讲解内容发布领域事件",
  "description": "用于跨模块交换事实记录的公共信封。业务载荷放在 payload 中；同一 event_id 的重试必须返回原事件。",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 8,
      "description": "事件唯一标识；来源系统重试沿用同一标识"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "CLAIM_DRAFTED",
        "CLAIM_REVISED",
        "CLAIM_EVIDENCE_ATTACHED",
        "CLAIM_EXPERT_REVIEWED",
        "CLAIM_APPROVED",
        "CLAIM_EMERGENCY_PUBLISHED",
        "CLAIM_COUNTERSIGNED",
        "NOTICE_EXPIRED",
        "TRANSLATION_REVISION_OPENED",
        "TRANSLATION_PROPOSED",
        "TRANSLATION_REVIEWED",
        "TRANSLATION_APPLIED",
        "PACKAGE_DEFINED",
        "PACKAGE_PUBLISHED",
        "DEVICE_REGISTERED",
        "DEVICE_ASSIGNED",
        "DEVICE_ACKNOWLEDGED"
      ],
      "description": "本领域事件类型"
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "knowledge_claim",
        "translation_revision",
        "content_package",
        "device_receipt"
      ],
      "description": "业务对象类型"
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1,
      "description": "业务对象标识"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "事实发生时间"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "同一聚合内从 1 起连续递增的对象版本"
    },
    "summary": {
      "type": "string",
      "minLength": 2,
      "description": "中文事实摘要"
    },
    "payload": {
      "type": "object",
      "description": "事件类型对应的业务载荷，字段约定见 README 的事件目录"
    }
  },
  "additionalProperties": true
}
